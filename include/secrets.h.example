// Copy to include/secrets.h (gitignored) and fill in, or run `mise run secrets` to write it
// from 1Password. See README.md.
#pragma once

// The network the bridge lives on: where it serves /files/ and /metrics.
#define HOME_WIFI_SSID "your-network"
#define HOME_WIFI_PASSWORD "your-password"

// The ez Share card's own access point. These are the card's factory defaults.
#define EZSHARE_SSID "ez Share"
#define EZSHARE_PASSWORD "88888888"

// Password for over-the-air updates (pio run -e nonpro-ota -t upload).
#define OTA_PASSWORD "change-me"

// Name sent with DHCP requests and announced over mDNS. Optional; defaults to ezshare-bridge.
// #define BRIDGE_HOSTNAME "ezshare-bridge"

// Syslog receiver for the bridge's log lines (RFC 5424 over UDP, port 514). Optional; off when unset.
// #define SYSLOG_HOST "syslog.example.lan"
